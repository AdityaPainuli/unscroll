{
  "name": "unscroll",
  "version": "0.1.0",
  "description": "Instagram content pipeline without the feed",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch --import tsx src/index.ts",
    "brief": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "cron-parser": "^5.10.2",
    "grammy": "^1.46.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
