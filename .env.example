# Telegram: create a bot with @BotFather, paste its token here.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id. Start the bot and send /whoami to get it.
# The bot ignores everyone else.
TELEGRAM_OWNER_ID=

# Instagram Graph API (Facebook Login flow, needed for Business Discovery).
# Leave both empty to run on demo data.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v26.0

# Claude. Leave empty to use an `ant auth login` profile instead.
ANTHROPIC_API_KEY=

# Weekly brief schedule (cron syntax) and timezone. Missed slots (laptop asleep or off) run on the next wake.
BRIEF_CRON=0 9 * * 0
SYNC_CRON=0 3 * * *
# IANA timezone, e.g. Asia/Kolkata. Empty uses the machine's timezone.
TZ=

# Outlier tuning.
BRIEF_SIZE=5
OUTLIER_MIN_RATIO=3
OUTLIER_WINDOW_DAYS=14

DB_PATH=data/studio.db
